{
  "name": "madeea-ea-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:isolation": "node scripts/check-integration-isolation.mjs",
    "check:functions": "node scripts/check-functions.mjs",
    "check:schedule": "node --experimental-strip-types scripts/check-capture-schedule.mjs",
    "deploy:functions": "node scripts/deploy-functions.mjs",
    "check:names": "node scripts/check-names.mjs",
    "check:gates": "node --experimental-strip-types scripts/check-clock-gates.mjs",
    "e2e:gates": "node scripts/e2e-clock-gates.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-virtual": "^3.14.10",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.12",
    "lucide-react": "^0.451.0",
    "marked": "^12.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tailwind-merge": "^2.5.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.61.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
